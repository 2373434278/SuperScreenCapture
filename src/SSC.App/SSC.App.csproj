<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>SSC.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants Condition="$(TargetFramework.Contains('-windows'))">$(DefineConstants);SSC_WINDOWS</DefineConstants>
    <DefineConstants Condition="!$(TargetFramework.Contains('-windows'))">$(DefineConstants);SSC_MAC</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SSC.UI/SSC.UI.csproj" />
    <ProjectReference Include="../SSC.Infrastructure/SSC.Infrastructure.csproj" />
    <ProjectReference Include="../SSC.Application/SSC.Application.csproj" />
    <ProjectReference Include="../SSC.Platform.Abstractions/SSC.Platform.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="../SSC.Platform.Windows/SSC.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="../SSC.Platform.Mac/SSC.Platform.Mac.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <Target Name="BuildMacNative"
          BeforeTargets="BeforeBuild"
          Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsOSPlatform('OSX')) And !$(TargetFramework.Contains('-windows'))">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../../build/mac/build-native.sh&quot;" />
  </Target>
  <Target Name="CopyMacNative"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsOSPlatform('OSX')) And !$(TargetFramework.Contains('-windows'))">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../artifacts/native/osx/libSSCMacKit.dylib"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMacNativePublish"
          AfterTargets="Publish"
          Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsOSPlatform('OSX')) And !$(TargetFramework.Contains('-windows'))">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../artifacts/native/osx/libSSCMacKit.dylib"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
