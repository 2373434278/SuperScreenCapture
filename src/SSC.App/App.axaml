<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SSC.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SSC.UI/Styles/Theme.axaml" />
        <ResourceInclude Source="avares://SSC.UI/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- Shared prototype-aligned controls; must load after FluentTheme so the
         design-system setters win over the platform defaults. -->
    <StyleInclude Source="avares://SSC.UI/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
