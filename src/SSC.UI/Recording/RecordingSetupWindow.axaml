<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Recording.RecordingSetupWindow"
        Title="SuperScreenCapture"
        Width="360"
        Height="330"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent">
  <Window.Styles>
    <!-- 原型 .rec-card .chip：深色玻璃上的半透明胶囊 -->
    <Style Selector="Border.rec-chip">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rec-chip TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#B8FFFFFF" />
    </Style>
    <Style Selector="Button.chip-button">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#B8FFFFFF" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip-button:pointerover">
      <Setter Property="Background" Value="#24FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#99FFFFFF" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.close:pointerover">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <!-- 与原型一致的深色玻璃卡片：无论主题如何，悬浮在桌面上的录制卡片保持深色。 -->
  <Border Background="#F20A0E16"
          BorderBrush="#29FFFFFF"
          BorderThickness="1"
          CornerRadius="20"
          Padding="24"
          BoxShadow="0 34 90 0 #A6000000">
    <Grid>
      <StackPanel HorizontalAlignment="Stretch" Spacing="0">
        <Border Width="54" Height="54" CornerRadius="27" Background="#29FF4757" BorderBrush="#4DFF4757" BorderThickness="1"
                HorizontalAlignment="Center" Margin="0,0,0,12">
          <Path Data="{StaticResource IcoRecord}"
                Stroke="#FF6B78"
                StrokeThickness="1.8"
                Width="24"
                Height="24"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="TitleText"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   LetterSpacing="-0.2"
                   HorizontalAlignment="Center" />

        <TextBlock x:Name="DescriptionText"
                   Margin="0,6,0,6"
                   FontSize="11.5"
                   LineHeight="18"
                   Foreground="#99FFFFFF"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />

        <TextBlock x:Name="RegionText"
                   Margin="0,0,0,10"
                   FontSize="10"
                   Foreground="#66FFFFFF"
                   TextAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,16">
          <Button x:Name="Resolution1440" Classes="chip-button" />
          <Button x:Name="Fps60" Classes="chip-button" />
          <Button x:Name="Bitrate12" Classes="chip-button" />
          <Button x:Name="MicrophoneButton" Classes="chip-button" />
        </StackPanel>

        <Button x:Name="StartButton" Height="40" CornerRadius="10" Background="{DynamicResource SscDangerGradient}"
                Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Path Data="M12 5a7 7 0 1 0 0 14a7 7 0 1 0 0-14M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6"
                  Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" />
            <TextBlock x:Name="StartText" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Button x:Name="CloseButton" Classes="close" Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0" />
    </Grid>
  </Border>
</Window>
