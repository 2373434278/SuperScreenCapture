<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Recording.RecordingSetupWindow"
        Title="SuperScreenCapture"
        Width="430"
        Height="382"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Foreground="{DynamicResource SscText}">
  <Window.Styles>
    <Style Selector="Button.choice">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Button.choice.active">
      <Setter Property="Background" Value="{DynamicResource SscAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SscAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SscAccent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary Path">
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource SscPanelBg}"
          BorderBrush="{DynamicResource SscBorder}"
          BorderThickness="1"
          CornerRadius="16"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Border x:Name="Header" Padding="16,14" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SscAccentSoft}">
            <Path Data="M12 4a8 8 0 1 1 0 16a8 8 0 1 1 0-16M12 8a4 4 0 1 1 0 8a4 4 0 1 1 0-8"
                  Stroke="{DynamicResource SscAccent}"
                  StrokeThickness="1.7"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SscText}" />
            <TextBlock x:Name="DescriptionText" FontSize="11" Foreground="{DynamicResource SscTextMuted}" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="CloseButton" Grid.Column="2" Content="×" Width="26" Height="26" Padding="0"
                  Background="Transparent" Foreground="{DynamicResource SscTextMuted}" FontSize="17"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="16,12,16,16" Spacing="10">
        <Border Background="{DynamicResource SscPanelAltBg}" CornerRadius="8" Padding="10,7">
          <TextBlock x:Name="RegionText" FontSize="11.5" Foreground="{DynamicResource SscTextMuted}" />
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ResolutionLabel" Classes="label" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
            <Button x:Name="Resolution1080" Classes="choice" Content="1080p" />
            <Button x:Name="Resolution1440" Classes="choice" Content="1440p" />
            <Button x:Name="Resolution2160" Classes="choice" Content="4K" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="FpsLabel" Classes="label" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
            <Button x:Name="Fps30" Classes="choice" Content="30" />
            <Button x:Name="Fps60" Classes="choice" Content="60" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="BitrateLabel" Classes="label" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
            <Button x:Name="Bitrate8" Classes="choice" Content="8M" />
            <Button x:Name="Bitrate12" Classes="choice" Content="12M" />
            <Button x:Name="Bitrate20" Classes="choice" Content="20M" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="MicrophoneLabel" Classes="label" />
          <Button x:Name="MicrophoneButton" Grid.Column="1" Classes="choice" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="SystemAudioLabel" Classes="label" />
          <TextBlock x:Name="SystemAudioValue" Grid.Column="1" FontSize="11" Foreground="{DynamicResource SscTextMuted}" />
        </Grid>

        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
          <Button x:Name="CancelButton" Classes="ghost" Content="Cancel" HorizontalAlignment="Stretch" />
          <Button x:Name="StartButton" Grid.Column="1" Classes="primary" Margin="8,0,0,0" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
              <Path Data="M12 5a7 7 0 1 0 0 14a7 7 0 1 0 0-14M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6" />
              <TextBlock x:Name="StartText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
