<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Recording.RecordingControlBarWindow"
        Title="SuperScreenCapture"
        Width="470"
        Height="58"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent">
  <Window.Styles>
    <!-- 原型 .rec-btn：深色玻璃控制条上的图标按钮 -->
    <Style Selector="Button.rec">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.rec:pointerover">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="Button.rec.active">
      <Setter Property="Background" Value="#427B7FFF" />
    </Style>
    <Style Selector="Button.rec:disabled">
      <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style Selector="Button.rec Path">
      <Setter Property="Stroke" Value="#BCFFFFFF" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rec:pointerover Path">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="Button.rec.active Path">
      <Setter Property="Stroke" Value="White" />
    </Style>

    <!-- 原型 .rec-stop：红色半透明底 + 红色描边图标 -->
    <Style Selector="Button.stop">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#2EFF4757" />
      <Setter Property="BorderBrush" Value="#57FF4757" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.stop:pointerover">
      <Setter Property="Background" Value="#47FF4757" />
    </Style>
    <Style Selector="Button.stop Path">
      <Setter Property="Stroke" Value="#FF7180" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border Background="#E00A0E16"
          BorderBrush="#29FFFFFF"
          BorderThickness="1"
          CornerRadius="15"
          BoxShadow="0 24 70 0 #99000000"
          Padding="8,12">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
      <Border x:Name="DragHandle" Grid.Column="0" Padding="8,0" Background="Transparent" Cursor="SizeAll">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border x:Name="RecordDot" Width="10" Height="10" CornerRadius="5" Background="#FF4757"
                  BoxShadow="0 0 0 4 #2EFF4757" />
          <TextBlock x:Name="TimeText" Text="00:00" FontSize="13.5" FontWeight="SemiBold" FontFamily="SF Mono, Menlo, Consolas, monospace"
                     Foreground="White" VerticalAlignment="Center" MinWidth="56" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="PhaseText" Grid.Column="1" IsVisible="False" FontSize="10.5" Foreground="#99FFFFFF"
                 VerticalAlignment="Center" Margin="2,0,6,0" />

      <Border Grid.Column="2" Width="1" Height="24" Background="#29FFFFFF" Margin="4,0,8,0" />

      <Button x:Name="MicButton" Grid.Column="3" Classes="rec">
        <Path Data="{StaticResource IcoMic}" />
      </Button>

      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" Margin="5,0,2,0" VerticalAlignment="Center">
        <Border x:Name="Level1" Width="2.5" Height="6" CornerRadius="2" Background="#FF17C964" Opacity="0.2" />
        <Border x:Name="Level2" Width="2.5" Height="9" CornerRadius="2" Background="#FF22D3EE" Opacity="0.2" />
        <Border x:Name="Level3" Width="2.5" Height="12" CornerRadius="2" Background="#FF22D3EE" Opacity="0.2" />
        <Border x:Name="Level4" Width="2.5" Height="15" CornerRadius="2" Background="#FF22D3EE" Opacity="0.2" />
        <Border x:Name="Level5" Width="2.5" Height="18" CornerRadius="2" Background="#FF17C964" Opacity="0.2" />
      </StackPanel>

      <Button x:Name="SystemAudioButton" Grid.Column="5" Classes="rec" IsEnabled="False">
        <Path Data="{StaticResource IcoSpeaker}" />
      </Button>

      <Button x:Name="CameraButton" Grid.Column="6" Classes="rec" IsEnabled="False">
        <Path Data="{StaticResource IcoCamera}" />
      </Button>

      <Button x:Name="PauseButton" Grid.Column="7" Classes="rec">
        <Path x:Name="PauseIcon" Data="{StaticResource IcoPause}" />
      </Button>

      <Border Grid.Column="8" Width="1" Height="24" Background="#29FFFFFF" Margin="7,0" />

      <Button x:Name="GearButton" Grid.Column="9" Classes="rec">
        <Path Data="{StaticResource IcoGear}" />
      </Button>

      <Button x:Name="StopButton" Grid.Column="10" Classes="stop" Margin="6,0,0,0">
        <Path Data="{StaticResource IcoStop}" />
      </Button>
    </Grid>
  </Border>
</Window>
