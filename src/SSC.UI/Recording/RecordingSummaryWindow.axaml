<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Recording.RecordingSummaryWindow"
        Title="SuperScreenCapture"
        Width="330"
        Height="320"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent">
  <Window.Styles>
    <Style Selector="Button.ghost">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#29FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#D9FFFFFF" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource SscAccent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#99FFFFFF" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.close:pointerover">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#B3FFFFFF" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Styles>

  <Border x:Name="Header"
          Background="#F70A0E16"
          BorderBrush="#29FFFFFF"
          BorderThickness="1"
          CornerRadius="18"
          Padding="22"
          BoxShadow="0 34 90 0 #A6000000">
    <Grid>
      <StackPanel HorizontalAlignment="Stretch" Spacing="0">
        <Border Width="52" Height="52" CornerRadius="26" Background="#1F17C964" HorizontalAlignment="Center" Margin="0,0,0,12">
          <Path Data="{StaticResource IcoCheck}"
                Stroke="{DynamicResource SscSuccess}"
                StrokeThickness="2.4"
                Width="24"
                Height="24"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="SavedTitle" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
        <TextBlock x:Name="SummaryText" Margin="0,5,0,0" FontSize="11" Foreground="#8CFFFFFF" HorizontalAlignment="Center" />
        <TextBlock x:Name="FilePathText" Margin="0,4,0,0" FontSize="10" Foreground="#66FFFFFF"
                   TextTrimming="CharacterEllipsis" MaxWidth="270" HorizontalAlignment="Center" />

        <Button x:Name="OpenFolderButton" Classes="link" HorizontalAlignment="Center" Margin="0,6,0,0" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,16,0,0">
          <Button x:Name="PlayButton" Classes="ghost" HorizontalAlignment="Stretch" />
          <Button x:Name="AgainButton" Grid.Column="1" Classes="primary" HorizontalAlignment="Stretch" />
        </Grid>
      </StackPanel>

      <Button x:Name="CloseButton" Classes="close" Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" />
    </Grid>
  </Border>
</Window>
