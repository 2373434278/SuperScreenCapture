<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Dialogs.PermissionGuideWindow"
        Title="SuperScreenCapture"
        Width="520"
        Height="430"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Foreground="{DynamicResource SscText}">
  <Border Background="{DynamicResource SscPanelBg}"
          BorderBrush="{DynamicResource SscBorderStrong}"
          BorderThickness="1"
          CornerRadius="20"
          Padding="26"
          BoxShadow="0 30 90 0 #80000000">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource SscAccentSoft}">
          <Path Data="{StaticResource IcoShield}"
                Stroke="{DynamicResource SscAccent}"
                StrokeThickness="1.7"
                Width="24"
                Height="24"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,10,0" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" LetterSpacing="-0.2" />
          <TextBlock x:Name="DescText" FontSize="11.5" Foreground="{DynamicResource SscTextMuted}" TextWrapping="Wrap" LineHeight="17" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="2" Classes="icon-btn" VerticalAlignment="Top">
          <Path Data="{StaticResource IcoClose}" />
        </Button>
      </Grid>

      <Border Grid.Row="1" Margin="0,18,0,0" Background="{DynamicResource SscPanelAltBg}" CornerRadius="12" Padding="14,4">
        <StackPanel>
          <Border x:Name="ScreenRow" Classes="set-row" Padding="0,11">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{StaticResource IcoCapture}"
                    Stroke="{DynamicResource SscTextMuted}" StrokeThickness="1.7"
                    Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock x:Name="ScreenLabel" Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border x:Name="ScreenChip" Grid.Column="2" Classes="chip ok" VerticalAlignment="Center">
                <TextBlock x:Name="ScreenChipText" />
              </Border>
            </Grid>
          </Border>

          <Border Classes="set-row" Padding="0,11">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{StaticResource IcoMic}"
                    Stroke="{DynamicResource SscTextMuted}" StrokeThickness="1.7"
                    Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock x:Name="MicrophoneLabel" Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border x:Name="MicrophoneChip" Grid.Column="2" Classes="chip ok" VerticalAlignment="Center">
                <TextBlock x:Name="MicrophoneChipText" />
              </Border>
            </Grid>
          </Border>

          <Border Classes="set-row" Padding="0,11">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{StaticResource IcoCamera}"
                    Stroke="{DynamicResource SscTextMuted}" StrokeThickness="1.7"
                    Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock x:Name="CameraLabel" Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border x:Name="CameraChip" Grid.Column="2" Classes="chip ok" VerticalAlignment="Center">
                <TextBlock x:Name="CameraChipText" />
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="8">
        <Border Background="{DynamicResource SscAccentSoft}" CornerRadius="8" Padding="10,8">
          <Grid ColumnDefinitions="Auto,*">
            <Path Data="{StaticResource IcoInfoSmall}"
                  Stroke="{DynamicResource SscAccent}" StrokeThickness="1.6"
                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,8,0" />
            <TextBlock x:Name="NoteText" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource SscAccent}" TextWrapping="Wrap" LineHeight="16" />
          </Grid>
        </Border>
        <TextBlock x:Name="RestartText" FontSize="10.5" Foreground="{DynamicResource SscWarningText}" TextWrapping="Wrap" IsVisible="False" />
      </StackPanel>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="LaterButton" Classes="btn btn-ghost" Height="32">
          <TextBlock x:Name="LaterText" />
        </Button>
        <Button x:Name="OpenSettingsButton" Classes="btn btn-primary" Height="32">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IcoLink}" />
            <TextBlock x:Name="OpenSettingsText" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
