<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SSC.UI.Controls"
        xmlns:ocr="using:SSC.UI.Ocr"
        xmlns:platform="using:SSC.UI.Platform"
        x:Class="SSC.UI.Ocr.OcrResultWindow"
        Title="SuperScreenCapture"
        Width="1000"
        Height="660"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle"
        Background="{DynamicResource SscWindowBackground}"
        Foreground="{DynamicResource SscText}"
        platform:WindowChrome.Mode="Native"
        platform:WindowChrome.TitleBarHeight="54">
  <Window.Styles>
    <Style Selector="ListBox.ocr-lines">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9" />
    </Style>
    <Style Selector="ListBox.ocr-lines ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.ocr-lines ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
    </Style>
    <Style Selector="ListBox.ocr-lines ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SscAccentSoft}" />
    </Style>
    <Style Selector="Button.line-copy">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.line-copy">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected Button.line-copy">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.line-copy:pointerover">
      <Setter Property="Background" Value="{DynamicResource SscPanel3Bg}" />
    </Style>
    <Style Selector="Button.line-copy Path">
      <Setter Property="Stroke" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sk">
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="54,*,30">
      <!-- 头部：返回、标题、引擎、语言、重新识别、关闭 + 右侧系统按钮 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <Border Grid.Column="0" Classes="captionbar" Background="{DynamicResource SscPanelBg}" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,0,0,1" Padding="{DynamicResource SscCaptionPadding}" platform:WindowChrome.IsDragArea="True">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
          <Button x:Name="BackButton" Classes="btn btn-ghost btn-sm" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="m9 6 6 6-6 6">
                <Path.RenderTransform>
                  <RotateTransform Angle="180" />
                </Path.RenderTransform>
              </Path>
              <TextBlock x:Name="BackText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,0,0,0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SscText}" VerticalAlignment="Center" />

          <Border Grid.Column="2" Classes="chip primary" Margin="8,0,0,0">
            <TextBlock x:Name="EngineText" />
          </Border>

          <Border Grid.Column="4" Classes="seg" VerticalAlignment="Center">
            <StackPanel x:Name="LanguageSeg" Orientation="Horizontal" Spacing="2" />
          </Border>

          <Button x:Name="RecognizeButton" Grid.Column="5" Classes="btn btn-ghost btn-sm" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IcoOcr}" />
              <TextBlock x:Name="RecognizeText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="CloseButton" Grid.Column="6" Classes="icon-btn" Margin="6,0,0,0">
            <Path Data="{StaticResource IcoClose}" />
          </Button>
        </Grid>
      </Border>
      <controls:CaptionButtons x:Name="SystemCaptionButtons" Grid.Column="1" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*">
        <!-- 左侧图像与识别框 -->
        <Border Grid.Column="0" Background="{DynamicResource SscPanelAltBg}" Padding="22">
          <Border Background="White" CornerRadius="10" ClipToBounds="True" BoxShadow="0 24 70 0 #55000000"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Stretch="Uniform" MaxWidth="560" MaxHeight="480">
              <Panel x:Name="CanvasHost" />
            </Viewbox>
          </Border>
        </Border>

        <!-- 右侧文本 -->
        <Border Grid.Column="1" Background="{DynamicResource SscPanelBg}" BorderBrush="{DynamicResource SscBorder}" BorderThickness="1,0,0,0">
          <Grid RowDefinitions="46,*,34">
            <Border Grid.Row="0" Padding="12,0" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                <Button x:Name="CopyAllButton" Classes="btn btn-ghost btn-sm">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IcoCopy}" />
                    <TextBlock x:Name="CopyAllText" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="CopySelectedButton" Grid.Column="1" Classes="btn btn-ghost btn-sm" Margin="7,0,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IcoCopy}" />
                    <TextBlock x:Name="CopySelectedText" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Panel Grid.Row="1">
              <ListBox x:Name="LineList" Classes="ocr-lines" SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="ocr:OcrLineRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="9,8,9,8">
                      <TextBlock Text="{Binding IndexText}"
                                 FontSize="9.5"
                                 FontFamily="SF Mono, Menlo, Consolas, monospace"
                                 Foreground="{DynamicResource SscTextSubtle}"
                                 VerticalAlignment="Top"
                                 Margin="0,2,8,0"
                                 MinWidth="14" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource SscText}" TextWrapping="Wrap" />
                      <Button Grid.Column="2" Classes="line-copy" Tag="{Binding}" Click="OnCopyLine" VerticalAlignment="Top">
                        <Path Data="{StaticResource IcoCopy}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel x:Name="EmptyState" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Margin="26" Background="{DynamicResource SscPanelBg}">
                <Path Data="{StaticResource IcoOcr}"
                      Stroke="{DynamicResource SscTextSubtle}" StrokeThickness="1.6" Width="34" Height="34" Stretch="Uniform" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SscTextMuted}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" FontSize="11.5" Foreground="{DynamicResource SscTextSubtle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
              </StackPanel>

              <Border x:Name="LoadingOverlay" IsVisible="False" Background="{DynamicResource SscPanelBg}" Padding="18">
                <StackPanel Spacing="12">
                  <Border Classes="sk" Width="320" />
                  <Border Classes="sk" Width="240" />
                  <Border Classes="sk" Width="360" />
                  <Border Classes="sk" Width="280" />
                  <Border Classes="sk" Width="340" />
                  <Border Classes="sk" Width="220" />
                  <TextBlock x:Name="LoadingText" FontSize="11" Foreground="{DynamicResource SscTextSubtle}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </Panel>

            <Border Grid.Row="2" Padding="12,0" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatsText" FontSize="10.5" Foreground="{DynamicResource SscTextSubtle}" VerticalAlignment="Center" />
                <TextBlock x:Name="LocalText" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource SscTextSubtle}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource SscPanelBg}" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,1,0,0" Padding="14,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource SscTextSubtle}" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource SscTextSubtle}" VerticalAlignment="Center" />
        </Grid>
      </Border>
  </Grid>
</Window>
