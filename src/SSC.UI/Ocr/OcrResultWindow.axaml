<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Ocr.OcrResultWindow"
        Title="SuperScreenCapture"
        Width="1000"
        Height="660"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SscWindowBackground}"
        Foreground="{DynamicResource SscText}">
  <Window.Styles>
    <Style Selector="Button.ghost">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SscAccent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="ListBox.ocr-lines">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="54,*,30">
    <Border Grid.Row="0"
            Background="{DynamicResource SscPanelBg}"
            BorderBrush="{DynamicResource SscBorder}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource SscAccentSoft}">
            <Path Data="M4 8V5h3M17 5h3v3M20 16v3h-3M7 19H4v-3M8 9h8M8 12h8M8 15h5"
                  Stroke="{DynamicResource SscAccent}"
                  StrokeThickness="1.7"
                  Width="14"
                  Height="14"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SscText}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="LanguageLabel" Classes="muted" VerticalAlignment="Center" />
          <ComboBox x:Name="LanguageBox" Width="150" Height="28" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="RecognizeButton" Classes="ghost" />
          <Button x:Name="CopyAllButton" Classes="primary" />
          <Button x:Name="CloseButton" Classes="ghost" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,370" Margin="16">
      <Border Grid.Column="0"
              Background="{DynamicResource SscPanelAltBg}"
              BorderBrush="{DynamicResource SscBorder}"
              BorderThickness="1"
              CornerRadius="14"
              ClipToBounds="True">
        <Panel>
          <Panel x:Name="CanvasHost" />
          <Border x:Name="LoadingOverlay"
                  IsVisible="False"
                  Background="#AA0B0E15">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
              <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
              <TextBlock x:Name="LoadingText" Foreground="{DynamicResource SscTextMuted}" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Panel>
      </Border>

      <Border Grid.Column="1"
              Classes="card"
              Background="{DynamicResource SscPanelBg}"
              BorderBrush="{DynamicResource SscBorder}"
              BorderThickness="1"
              CornerRadius="14"
              Margin="12,0,0,0"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="14,10" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="LinesTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SscText}" VerticalAlignment="Center" />
              <Button x:Name="CopySelectedButton" Grid.Column="1" Classes="ghost" Height="28" Padding="10,0" />
            </Grid>
          </Border>

          <Panel Grid.Row="1">
            <ListBox x:Name="LineList" Classes="ocr-lines" SelectionMode="Single">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10,7" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource SscText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Confidence, StringFormat={}{0:P0}}" FontSize="10" Foreground="{DynamicResource SscTextMuted}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
          </Panel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource SscPanelBg}"
            BorderBrush="{DynamicResource SscBorder}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Classes="muted" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="M6" FontSize="10" Foreground="{DynamicResource SscTextMuted}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
