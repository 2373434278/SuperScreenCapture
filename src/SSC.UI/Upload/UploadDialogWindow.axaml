<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Upload.UploadDialogWindow"
        Title="SuperScreenCapture"
        Width="520"
        Height="620"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SscWindowBackground}"
        Foreground="{DynamicResource SscText}">
  <Window.Styles>
    <Style Selector="Button.ghost">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SscAccent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="TextBlock.field">
      <Setter Property="Foreground" Value="{DynamicResource SscText}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="TextBox.input">
      <Setter Property="Height" Value="30" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="56,*,34">
    <Border Grid.Row="0" Background="{DynamicResource SscPanelBg}" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Path Data="M12 16V4M7 9l5-5 5 5M4 16v4h16v-4"
                Stroke="{DynamicResource SscAccent}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" />
          <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SscText}" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Classes="ghost" Content="×" Width="30" Padding="0" FontSize="16" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="16">
      <StackPanel Spacing="12">
        <Border Background="{DynamicResource SscAccentSoft}" CornerRadius="8" Padding="10,8">
          <TextBlock x:Name="NoteText" FontSize="11" Foreground="{DynamicResource SscAccent}" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="140,*" Height="34">
          <TextBlock x:Name="ProviderLabel" Classes="field" VerticalAlignment="Center" />
          <ComboBox x:Name="ProviderBox" Grid.Column="1" Height="30" />
        </Grid>

        <StackPanel x:Name="FieldsPanel" Spacing="9" />

        <Grid ColumnDefinitions="140,*" Height="34">
          <TextBlock x:Name="EnableLabel" Classes="field" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="EnableSwitch" Grid.Column="1" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
        </Grid>

        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" IsVisible="False" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Classes="ghost" />
          <Button x:Name="UploadButton" Classes="primary" />
        </StackPanel>

        <Border x:Name="ResultPanel" IsVisible="False" Background="{DynamicResource SscPanelBg}" BorderBrush="{DynamicResource SscBorder}"
                BorderThickness="1" CornerRadius="10" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock x:Name="ResultTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SscText}" />
            <TextBox x:Name="UrlBox" Classes="input" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="CopyLinkButton" Classes="ghost" />
              <Button x:Name="OpenLinkButton" Classes="ghost" />
              <Button x:Name="DeleteRemoteButton" Classes="ghost" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource SscPanelBg}" BorderBrush="{DynamicResource SscBorder}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Classes="muted" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="M6" FontSize="10" Foreground="{DynamicResource SscTextMuted}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
