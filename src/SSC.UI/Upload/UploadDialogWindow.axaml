<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSC.UI.Upload.UploadDialogWindow"
        Title="SuperScreenCapture"
        Width="580"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Foreground="{DynamicResource SscText}">
  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SscTextSubtle}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="31" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource SscPanelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SscBorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- 原型 P7：580px 宽的模态卡片，深色/浅色主题共用面板底色。 -->
  <Border Background="{DynamicResource SscPanelBg}"
          BorderBrush="{DynamicResource SscBorderStrong}"
          BorderThickness="1"
          CornerRadius="18"
          Padding="22"
          BoxShadow="0 30 90 0 #8C000000">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- 头部 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="4">
          <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SscText}" LetterSpacing="-0.2" />
          <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{DynamicResource SscTextMuted}" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Classes="icon-btn" VerticalAlignment="Top">
          <Path Data="{StaticResource IcoClose}" />
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <StackPanel x:Name="FormPanel" Spacing="12">
          <!-- 隐私提示 -->
          <Border Background="{DynamicResource SscWarningSoft}" CornerRadius="9" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*">
              <Path Data="{StaticResource IcoShield}"
                    Stroke="{DynamicResource SscWarningText}" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform"
                    VerticalAlignment="Top" Margin="0,1,0,0" />
              <TextBlock x:Name="NoteText" Grid.Column="1" Margin="9,0,0,0" FontSize="10.5"
                         Foreground="{DynamicResource SscWarningText}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <!-- 文件卡片 -->
          <Border Background="{DynamicResource SscPanelAltBg}" BorderBrush="{DynamicResource SscBorder}" BorderThickness="1"
                  CornerRadius="10" Padding="11">
            <Grid ColumnDefinitions="Auto,*">
              <Border Width="56" Height="42" CornerRadius="7" ClipToBounds="True" Background="#0B0F16">
                <Image x:Name="PreviewImage" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="FileNameText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SscText}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FileMetaText" FontSize="10.5" Foreground="{DynamicResource SscTextSubtle}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- 服务商 -->
          <StackPanel Spacing="0">
            <TextBlock x:Name="ProviderLabel" Classes="field-label" />
            <ComboBox x:Name="ProviderBox" Classes="input" HorizontalAlignment="Stretch" />
          </StackPanel>

          <!-- 动态字段 -->
          <WrapPanel x:Name="FieldsPanel" Orientation="Horizontal" ItemWidth="250" />

          <!-- 启用上传 -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
            <TextBlock x:Name="EnableLabel" FontSize="10.5" Foreground="{DynamicResource SscTextSubtle}" VerticalAlignment="Center" />
            <ToggleButton x:Name="EnableSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center" />
          </Grid>

          <!-- 进度 -->
          <StackPanel x:Name="ProgressPanel" Spacing="6" IsVisible="False">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="7" CornerRadius="999" />
            <TextBlock x:Name="ProgressText" FontSize="10.5" Foreground="{DynamicResource SscTextSubtle}" />
          </StackPanel>

          </StackPanel>

          <!-- 结果 -->
          <Border x:Name="ResultPanel" IsVisible="False" Background="{DynamicResource SscPanelAltBg}"
                  BorderBrush="{DynamicResource SscBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel Spacing="10">
              <Border x:Name="SuccessRing" Width="54" Height="54" CornerRadius="27" Background="{DynamicResource SscSuccessSoft}" HorizontalAlignment="Center">
                <Path Data="{StaticResource IcoCheck}" Stroke="{DynamicResource SscSuccess}" StrokeThickness="2.4" Width="26" Height="26"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="FailureRing" Width="54" Height="54" CornerRadius="27" Background="{DynamicResource SscDangerSoft}" HorizontalAlignment="Center" IsVisible="False">
                <Path Data="{StaticResource IcoClose}" Stroke="{DynamicResource SscDanger}" StrokeThickness="2.4" Width="26" Height="26"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <TextBlock x:Name="ResultTitle" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource SscText}" />
              <TextBlock x:Name="ResultDescription" FontSize="11.5" Foreground="{DynamicResource SscTextMuted}" TextAlignment="Center" TextWrapping="Wrap" />

              <Border x:Name="LinkBox" Background="{DynamicResource SscPanelBg}" BorderBrush="{DynamicResource SscBorder}" BorderThickness="1" CornerRadius="9" Padding="11,9">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Data="{StaticResource IcoLink}"
                        Stroke="{DynamicResource SscTextSubtle}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBox x:Name="UrlBox" Grid.Column="1" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                           FontSize="11" FontFamily="SF Mono, Menlo, Consolas, monospace" Margin="8,0,0,0" />
                </Grid>
              </Border>

              <Grid x:Name="LinkActions" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button x:Name="CopyLinkButton" Classes="btn btn-ghost" Height="32" FontSize="11" />
                <Button x:Name="OpenLinkButton" Grid.Column="1" Classes="btn btn-ghost" Height="32" FontSize="11" />
                <Button x:Name="DeleteRemoteButton" Grid.Column="2" Classes="btn btn-ghost" Height="32" FontSize="11"
                        Foreground="{DynamicResource SscDanger}" />
              </Grid>

              <Button x:Name="RetryButton" Classes="btn btn-primary" Height="32" HorizontalAlignment="Stretch" IsVisible="False" />
            </StackPanel>
          </Border>

          <TextBlock x:Name="StatusText" Classes="muted" FontSize="11" />
        </StackPanel>
      </ScrollViewer>

      <!-- 底部操作 -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
        <TextBlock x:Name="FooterHint" FontSize="10" Foreground="{DynamicResource SscTextSubtle}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="CancelButton" Grid.Column="1" Classes="btn btn-ghost" IsCancel="True" />
        <Button x:Name="UploadButton" Grid.Column="2" Classes="btn btn-primary" Margin="8,0,0,0" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="{StaticResource IcoUpload}" />
            <TextBlock x:Name="UploadText" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
