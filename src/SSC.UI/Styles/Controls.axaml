<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Shared control styles translated from prototype/index.html.
    Every interactive control opts into the same typography, radii and centering
    rules so secondary windows cannot drift from the P5 shell styling.
  -->

  <!-- ============ Typography ============ -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="SF Pro Text, PingFang SC, Segoe UI, Microsoft YaHei, sans-serif" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="SF Pro Text, PingFang SC, Segoe UI, Microsoft YaHei, sans-serif" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="SF Pro Text, PingFang SC, Segoe UI, Microsoft YaHei, sans-serif" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="SF Pro Text, PingFang SC, Segoe UI, Microsoft YaHei, sans-serif" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource SscTextSubtle}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource SscTextSubtle}" />
    <Setter Property="FontSize" Value="10.5" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="SF Mono, Menlo, Consolas, monospace" />
  </Style>

  <!-- ============ Buttons ============ -->
  <!--
    Base rule fixes the reported "text not centered" issue: Avalonia's Fluent
    template honours Horizontal/VerticalContentAlignment, and the prototype
    button is an inline-flex box with centered content.
  -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="SF Pro Text, PingFang SC, Segoe UI, Microsoft YaHei, sans-serif" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- 按钮内的 TextBlock/StackPanel/Path 统一垂直居中，
       修复中文与图标在顶栏、分段控件中偏上的问题。 -->
  <Style Selector="Button TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button Path">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.btn">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.btn Path">
    <Setter Property="Stroke" Value="{DynamicResource SscText}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <Style Selector="Button.btn-primary">
    <Setter Property="Background" Value="{DynamicResource SscPrimaryGradient}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.btn-primary:pointerover">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.btn-primary:pressed">
    <Setter Property="Opacity" Value="0.84" />
  </Style>
  <Style Selector="Button.btn-primary Path">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <Style Selector="Button.btn-ghost">
    <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
  </Style>
  <Style Selector="Button.btn-ghost:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorderStrong}" />
  </Style>
  <Style Selector="Button.btn-ghost Path">
    <Setter Property="Stroke" Value="{DynamicResource SscTextMuted}" />
  </Style>

  <Style Selector="Button.btn-outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>
  <Style Selector="Button.btn-outline:pointerover">
    <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
  </Style>

  <Style Selector="Button.btn-danger">
    <Setter Property="Background" Value="{DynamicResource SscDanger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.btn-sm">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="Button.btn-sm Path">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- ============ Segmented control ============ -->
  <Style Selector="Border.seg">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="Background" Value="{DynamicResource SscPanelBg}" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>
  <Style Selector="Button.seg:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>

  <!-- ============ Chips ============ -->
  <Style Selector="Border.chip">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
  </Style>
  <Style Selector="Border.chip.ok">
    <Setter Property="Background" Value="{DynamicResource SscSuccessSoft}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.chip.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SscSuccess}" />
  </Style>
  <Style Selector="Border.chip.warn">
    <Setter Property="Background" Value="{DynamicResource SscWarningSoft}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.chip.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SscWarning}" />
  </Style>
  <Style Selector="Border.chip.bad">
    <Setter Property="Background" Value="{DynamicResource SscDangerSoft}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.chip.bad TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SscDanger}" />
  </Style>
  <Style Selector="Border.chip.primary">
    <Setter Property="Background" Value="{DynamicResource SscAccentSoft}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.chip.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SscAccent}" />
  </Style>

  <!-- Filter chip (P4): neutral pill, active pill inverts to text colour. -->
  <Style Selector="Button.filter-chip">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.filter-chip:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
  </Style>
  <Style Selector="Button.filter-chip.active">
    <Setter Property="Background" Value="{DynamicResource SscText}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SscPanelBg}" />
  </Style>

  <!-- ============ Inputs ============ -->
  <Style Selector="TextBox.input">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SscPanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.input:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource SscAccent}" />
  </Style>

  <Style Selector="ComboBox.input">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SscPanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource SscText}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ============ Switch (36 x 21, matches prototype .switch) ============ -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="21" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Track"
                Background="{DynamicResource SscPanel3Bg}"
                BorderBrush="{DynamicResource SscBorderStrong}"
                BorderThickness="1"
                CornerRadius="999">
          <Border x:Name="Knob"
                  Width="15"
                  Height="15"
                  CornerRadius="999"
                  Background="White"
                  HorizontalAlignment="Left"
                  Margin="2,0,0,0">
            <Border.Effect>
              <DropShadowEffect BlurRadius="3" OffsetY="1" Opacity="0.25" />
            </Border.Effect>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource SscPrimaryGradient}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#Knob">
    <Setter Property="Margin" Value="17,0,0,0" />
  </Style>
  <Style Selector="ToggleButton.switch:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- ============ Surfaces ============ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SscPanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.frame">
    <Setter Property="Margin" Value="14" />
    <Setter Property="Background" Value="{DynamicResource SscWindowBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.set-row">
    <Setter Property="BorderBrush" Value="{DynamicResource SscBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="50" />
  </Style>

  <!-- ============ Icon button ============ -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
  </Style>
  <Style Selector="Button.icon-btn Path">
    <Setter Property="Stroke" Value="{DynamicResource SscTextMuted}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource SscText}" />
  </Style>

  <!-- ============ Motion ============ -->
  <!-- 只过渡颜色，不动布局；140-160ms 与原型一致。 -->
  <Style Selector="Button">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 键盘焦点环：仅在键盘导航时显示，鼠标点击不出现。 -->
  <Style Selector="Button:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource SscAccent}"
                BorderThickness="1.5"
                CornerRadius="9"
                Margin="-3" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="TextBox:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource SscAccent}"
                BorderThickness="1.5"
                CornerRadius="8"
                Margin="-2" />
      </Template>
    </Setter>
  </Style>
</Styles>
