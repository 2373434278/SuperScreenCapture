<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editing="using:SSC.UI.Editing"
        x:Class="SSC.UI.Editing.AnnotationEditorWindow"
        Title="SuperScreenCapture"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SscBackdropBg}"
        Foreground="{DynamicResource SscText}">
  <Window.Styles>
    <!-- 图标按钮（原型 .icon-btn） -->
    <Style Selector="Button.editor-icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.editor-icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource SscPanelAltBg}" />
    </Style>
    <Style Selector="Button.editor-icon Path">
      <Setter Property="Stroke" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.editor-icon:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource SscText}" />
    </Style>

    <!-- 工具轨按钮（原型 .tool） -->
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="35" />
      <Setter Property="Height" Value="35" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="Background" Value="{DynamicResource SscPanel3Bg}" />
    </Style>
    <Style Selector="Button.tool.active">
      <Setter Property="Background" Value="{DynamicResource SscPrimaryGradient}" />
    </Style>
    <Style Selector="Button.tool Path">
      <Setter Property="Stroke" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool.active Path">
      <Setter Property="Stroke" Value="White" />
    </Style>

    <!-- 颜色圆点（原型 .swatch-btn） -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.swatch.active">
      <Setter Property="BorderBrush" Value="{DynamicResource SscText}" />
    </Style>

    <Style Selector="TextBlock.prop">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontFamily" Value="SF Mono, Menlo, Consolas, monospace" />
      <Setter Property="Foreground" Value="{DynamicResource SscTextSubtle}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="22" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prop-sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="{DynamicResource SscBorder}" />
      <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- 历史控制组（原型 .hist） -->
    <Style Selector="Button.hist-btn">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.hist-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource SscPanel3Bg}" />
    </Style>
    <Style Selector="Button.hist-btn Path">
      <Setter Property="Stroke" Value="{DynamicResource SscTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </Window.Styles>

  <!-- 编辑器外壳：原型 P2 中 screen padding 16 + rounded editor-shell。 -->
  <Border Classes="frame" Margin="16" CornerRadius="18">
    <Grid RowDefinitions="52,*,56">
      <!-- 顶栏 -->
      <Border Grid.Row="0"
              Background="{DynamicResource SscPanelBg}"
              BorderBrush="{DynamicResource SscBorder}"
              BorderThickness="0,0,0,1"
              Padding="14,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button x:Name="RetakeButton" Classes="btn btn-ghost btn-sm" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="M4 5h16v14H4z" />
              <TextBlock x:Name="RetakeText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center">
            <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource SscSuccess}" />
            <TextBlock x:Name="FileNameText" FontSize="12" Foreground="{DynamicResource SscTextMuted}" VerticalAlignment="Center" />
            <TextBlock x:Name="DimensionsText" FontSize="11" Foreground="{DynamicResource SscTextSubtle}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="OcrButton" Classes="editor-icon">
              <Path Data="M4 8V5h3M17 5h3v3M20 16v3h-3M7 19H4v-3M8 9h8M8 12h8M8 15h5" />
            </Button>
            <Button x:Name="UploadButton" Classes="editor-icon">
              <Path Data="M12 16V4M7 9l5-5 5 5M4 16v4h16v-4" />
            </Button>
            <Button x:Name="PinButton" Classes="editor-icon">
              <Path Data="M9 4h6l-1 6 4 3v2H6v-2l4-3-1-6ZM12 15v5" />
            </Button>
            <Button x:Name="DoneButton" Classes="btn btn-primary btn-sm" Margin="6,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="m4 12 5 5L20 6" />
                <TextBlock x:Name="DoneText" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="52,*">
        <!-- 工具轨 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SscPanelAltBg}"
                BorderBrush="{DynamicResource SscBorder}"
                BorderThickness="0,0,1,0"
                Padding="0,7">
          <StackPanel x:Name="ToolRail" Spacing="2" HorizontalAlignment="Center" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="46,*,56">
          <!-- 属性栏 -->
          <Border Grid.Row="0"
                  Background="{DynamicResource SscPanelBg}"
                  BorderBrush="{DynamicResource SscBorder}"
                  BorderThickness="0,0,0,1"
                  Padding="14,0">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <TextBlock x:Name="ColorLabel" Classes="prop" />
                <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
                <Border Classes="prop-sep" />
                <TextBlock x:Name="WidthLabel" Classes="prop" />
                <Slider x:Name="WidthSlider"
                        Width="90"
                        Minimum="1"
                        Maximum="12"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True" />
                <TextBlock x:Name="WidthValue" Classes="val" />
                <Border Classes="prop-sep" />
                <TextBlock x:Name="FontLabel" Classes="prop" />
                <Slider x:Name="FontSlider"
                        Width="90"
                        Minimum="12"
                        Maximum="56"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True" />
                <TextBlock x:Name="FontValue" Classes="val" />
                <Border Classes="prop-sep" />
                <TextBlock x:Name="StrengthLabel" Classes="prop" />
                <Border Classes="seg" Height="28" Padding="3" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="StrengthSmall" Classes="seg" Content="S" Width="28" Padding="0" IsTabStop="False" />
                    <Button x:Name="StrengthMedium" Classes="seg" Content="M" Width="28" Padding="0" IsTabStop="False" />
                    <Button x:Name="StrengthLarge" Classes="seg" Content="L" Width="28" Padding="0" IsTabStop="False" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- 画布区：面板底色 + 14px 点阵 -->
          <Border Grid.Row="1" Background="{DynamicResource SscPanel3Bg}" ClipToBounds="True">
            <Panel>
              <editing:DotGridBackground />
              <Panel x:Name="CanvasHost" />
              <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                <TextBox x:Name="TextInputBox"
                         Width="280"
                         Height="34"
                         IsVisible="False"
                         FontSize="15"
                         Padding="8,4"
                         CornerRadius="7" />
              </Canvas>
            </Panel>
          </Border>

          <!-- 底栏 -->
          <Border Grid.Row="2"
                  Background="{DynamicResource SscPanelBg}"
                  BorderBrush="{DynamicResource SscBorder}"
                  BorderThickness="0,1,0,0"
                  Padding="14,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
              <Border Grid.Column="0"
                      Background="{DynamicResource SscPanelAltBg}"
                      BorderBrush="{DynamicResource SscBorder}"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="3"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="1">
                  <Button x:Name="UndoButton" Classes="hist-btn">
                    <Path Data="M9 7 4 12l5 5M4 12h9a6 6 0 0 1 0 12" />
                  </Button>
                  <TextBlock x:Name="UndoCountText" Classes="val" Width="18" />
                  <Button x:Name="RedoButton" Classes="hist-btn">
                    <Path Data="m15 7 5 5-5 5M20 12h-9a6 6 0 0 0 0 12" />
                  </Button>
                  <TextBlock x:Name="RedoCountText" Classes="val" Width="18" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="chip" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path x:Name="ToolChipIcon"
                        Data="M4 5h16v14H4z"
                        Stroke="{DynamicResource SscAccent}"
                        StrokeThickness="1.7"
                        Width="12"
                        Height="12"
                        Stretch="Uniform"
                        VerticalAlignment="Center" />
                  <TextBlock x:Name="ToolChipText" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="StatusText"
                         Grid.Column="2"
                         Margin="12,0,0,0"
                         FontSize="10.5"
                         Foreground="{DynamicResource SscTextSubtle}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />

              <Button x:Name="CopyButton" Grid.Column="4" Classes="btn btn-ghost btn-sm" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M9 9h11v11H9zM15 5H6a2 2 0 0 0-2 2v9" />
                  <TextBlock x:Name="CopyText" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button x:Name="SaveButton" Grid.Column="5" Classes="btn btn-ghost btn-sm" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button.Flyout>
                  <MenuFlyout Placement="TopEdgeAlignedRight">
                    <MenuItem Header="PNG" Click="OnSavePng" />
                    <MenuItem Header="JPG" Click="OnSaveJpg" />
                    <MenuItem Header="WebP" Click="OnSaveWebp" />
                  </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M5 4h11l3 3v13H5zM8 4v6h8V4M8 20v-6h8v6" />
                  <TextBlock x:Name="SaveText" VerticalAlignment="Center" />
                  <Path Data="M6 9l6 6 6-6" Width="12" Height="12" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
